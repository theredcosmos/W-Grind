PORT=5000
DB_HOST=localhost
DB_USER=root
# DB_PASS is intentionally not stored in the project files. 
# It is securely loaded from OS-level user environment variables.
DB_NAME=leetcode_tracker
# Long random string used to sign login sessions (required in production).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Optional: Firebase Web API key, enables verified Google sign-in.
FIREBASE_API_KEY=
# Optional: comma-separated list of allowed frontend origins (defaults to any).
CORS_ORIGIN=
